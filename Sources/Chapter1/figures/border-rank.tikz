\begin{tikzpicture}[scale=1.2, >=Stealth]
  % Palette definitions matching thesis style
  \definecolor{rankTwoBg}{HTML}{F0F5FA}
  \definecolor{rankThreeBg}{HTML}{FAF0F2}
  \definecolor{rankTwoText}{HTML}{1A5276}
  \definecolor{rankThreeText}{HTML}{7D3C98}
  \definecolor{borderPointCol}{HTML}{B03A2E}
  \definecolor{varietyLineCol}{HTML}{2874A6}

  % Organic outer blob path with spacious interior
  \def\blobPath{
    (-4.8, 0.1) .. controls (-4.9, 1.8) and (-2.4, 2.5) .. (0.6, 2.3)
                .. controls (2.9, 2.1) and (4.8, 1.4) .. (4.9, -0.2)
                .. controls (5.0, -1.8) and (2.4, -2.4) .. (-0.6, -2.3)
                .. controls (-2.8, -2.2) and (-4.7, -1.5) .. cycle
  }

  % Region Fills & Internal Line clipped strictly inside the blob boundary
  \begin{scope}
    \clip \blobPath;
    
    % Rank 3 background (entire space)
    \fill[rankThreeBg] (-5.5, -3) rectangle (5.5, 3);
    
    % Rank 2 background (left side of separating curve)
    \fill[rankTwoBg] 
      (0.6, 2.6) .. controls (0.2, 0.7) and (0.8, -0.7) .. (0.4, -2.6)
      -- (-5.5, -2.6) -- (-5.5, 2.6) -- cycle;

    % Dashed smooth curve representing the boundary (frontier of rank 2 variety)
    \draw[very thick, dashed, borderPointCol]
      (0.6, 2.6) .. controls (0.2, 0.7) and (0.8, -0.7) .. (0.4, -2.6);
  \end{scope}

  % Smooth organic outer boundary stroke
  \draw[cGrey!70!black, thick] \blobPath;

  % Points along the arch trajectory (nicely spaced inside rank 2 region)
  \coordinate (P1) at (-3.4, -0.6);
  \coordinate (P2) at (-2.4, -0.05);
  \coordinate (P3) at (-1.5, 0.28);
  \coordinate (P4) at (-0.6, 0.40);
  \coordinate (P5) at (0.0, 0.44);

  % Border point (Tensor di rango 3 al bordo) exactly on the dashed separating line
  \coordinate (B) at (0.42, 0.45);

  % Dashed arch path matching the point sequence (no arrow tip at the end)
  \draw[dashed, varietyLineCol, thick] 
    (P1) .. controls (-2.1, 0.42) and (-0.5, 0.50) .. (B);

  % Points representing sequence T_epsilon
  \foreach \p in {P1, P2, P3, P4, P5} {
    \fill[varietyLineCol] (\p) circle (2.5pt);
    \draw[white, thin] (\p) circle (2.5pt);
  }

  % Border tensor point on the dashed boundary line
  \fill[borderPointCol] (B) circle (4.5pt);
  \draw[white, thick] (B) circle (4.5pt);
  \fill[borderPointCol!40!black] (B) circle (2pt);

  % Labels with regular weight text
  \node[font=\large\color{rankTwoText}, align=center] at (-2.3, -1.1) {Tensori di rango $2$};
  \node[font=\large\color{rankThreeText}, align=center] at (2.7, -0.6) {Tensori di rango $3$};

  % Label directly to the right of the border tensor point
  \node[anchor=west, font=\small\color{borderPointCol}, align=left] at ($(B)+(0.25,0.02)$) {Tensore di rango $3$\\al bordo};

\end{tikzpicture}
