\providecommand{\Tn}[1]{\mathcal{#1}}
\providecommand{\Mx}[1]{\mathbf{#1}}

\definecolor{tensorMain}{HTML}{6B46C1}
\definecolor{tensorMainLight}{HTML}{9F7AEA}
\definecolor{vecA}{HTML}{1A73E8} % Blue for a
\definecolor{vecB}{HTML}{E65100} % Orange for b
\definecolor{vecC}{HTML}{0F9D58} % Green for c
\definecolor{bgBox}{HTML}{F8F9FA}

\begin{tikzpicture}[
  >=Stealth,
  scale=0.95,
  tensorLabel/.style={font=\Large\bfseries},
  plusStyle/.style={font=\Huge\bfseries, text=gray!70},
  termLabel/.style={font=\normalsize\bfseries}
]

  % --- BACKGROUND PANEL ---
  \begin{pgfonlayer}{background}
    \fill[bgBox, draw=gray!35, rounded corners=10pt, line width=0.9pt] (-0.8, -0.6) rectangle (16.0, 4.4);
  \end{pgfonlayer}

  % --- LEFT: Main Tensor T (3D Cube/Block) ---
  \begin{scope}[shift={(0, 0.5)}]
    % Front face
    \draw[fill=tensorMainLight!25, draw=tensorMain, thick] (0,0) rectangle (1.8, 2.2);
    % Top face
    \draw[fill=tensorMainLight!40, draw=tensorMain, thick] (0,2.2) -- (0.7, 2.9) -- (2.5, 2.9) -- (1.8, 2.2) -- cycle;
    % Side face
    \draw[fill=tensorMainLight!15, draw=tensorMain, thick] (1.8,0) -- (2.5, 0.7) -- (2.5, 2.9) -- (1.8, 2.2) -- cycle;
    
    % Tensor label
    \node at (0.9, 1.1) {\Huge $T$};
    \node[below=0.15cm] at (1.25, 0) {\footnotesize $\in \mathbb{R}^{n \times m \times p}$};
  \end{scope}

  % Equal sign
  \node[plusStyle] at (3.2, 1.9) {$=$};

  % --- RANK-1 TENSOR TERMS ---
  % Term 1: a1, b1, c1
  \begin{scope}[shift={(4.1, 0.5)}]
    % Vector a (vertical, blue)
    \draw[line width=5pt, vecA, opacity=0.3, line cap=round] (0, 0.15) -- (0, 2.1);
    \draw[line width=3.2pt, vecA, line cap=round] (0, 0.15) -- (0, 2.1);
    \node[right=1pt, font=\normalsize\bfseries, text=vecA!90!black] at (0, 0.4) {$a_1$};

    % Vector b (horizontal, orange)
    \draw[line width=5pt, vecB, opacity=0.3, line cap=round] (0.15, 2.18) -- (1.85, 2.18);
    \draw[line width=3.2pt, vecB, line cap=round] (0.15, 2.18) -- (1.85, 2.18);
    \node[right=1pt, font=\normalsize\bfseries, text=vecB!90!black] at (1.85, 2.18) {$b_1$};

    % Vector c (depth/diagonal, green)
    \draw[line width=5pt, vecC, opacity=0.3, line cap=round] (0.2, 2.4) -- (0.95, 3.15);
    \draw[line width=3.2pt, vecC, line cap=round] (0.2, 2.4) -- (0.95, 3.15);
    \node[right=1pt, font=\normalsize\bfseries, text=vecC!90!black] at (0.95, 3.15) {$c_1$};
  \end{scope}

  \node[plusStyle] at (7.1, 1.9) {$+$};

  % Term 2: a2, b2, c2
  \begin{scope}[shift={(7.9, 0.5)}]
    % Vector a (vertical, blue)
    \draw[line width=5pt, vecA, opacity=0.3, line cap=round] (0, 0.15) -- (0, 2.1);
    \draw[line width=3.2pt, vecA, line cap=round] (0, 0.15) -- (0, 2.1);
    \node[right=1pt, font=\normalsize\bfseries, text=vecA!90!black] at (0, 0.4) {$a_2$};

    % Vector b (horizontal, orange)
    \draw[line width=5pt, vecB, opacity=0.3, line cap=round] (0.15, 2.18) -- (1.85, 2.18);
    \draw[line width=3.2pt, vecB, line cap=round] (0.15, 2.18) -- (1.85, 2.18);
    \node[right=1pt, font=\normalsize\bfseries, text=vecB!90!black] at (1.85, 2.18) {$b_2$};

    % Vector c (depth/diagonal, green)
    \draw[line width=5pt, vecC, opacity=0.3, line cap=round] (0.2, 2.4) -- (0.95, 3.15);
    \draw[line width=3.2pt, vecC, line cap=round] (0.2, 2.4) -- (0.95, 3.15);
    \node[right=1pt, font=\normalsize\bfseries, text=vecC!90!black] at (0.95, 3.15) {$c_2$};
  \end{scope}

  \node[plusStyle] at (11.1, 1.9) {$+\, \cdots \,+$};

  % Term r: ar, br, cr
  \begin{scope}[shift={(13.1, 0.5)}]
    % Vector a (vertical, blue)
    \draw[line width=5pt, vecA, opacity=0.3, line cap=round] (0, 0.15) -- (0, 2.1);
    \draw[line width=3.2pt, vecA, line cap=round] (0, 0.15) -- (0, 2.1);
    \node[right=1pt, font=\normalsize\bfseries, text=vecA!90!black] at (0, 0.4) {$a_r$};

    % Vector b (horizontal, orange)
    \draw[line width=5pt, vecB, opacity=0.3, line cap=round] (0.15, 2.18) -- (1.85, 2.18);
    \draw[line width=3.2pt, vecB, line cap=round] (0.15, 2.18) -- (1.85, 2.18);
    \node[right=1pt, font=\normalsize\bfseries, text=vecB!90!black] at (1.85, 2.18) {$b_r$};

    % Vector c (depth/diagonal, green)
    \draw[line width=5pt, vecC, opacity=0.3, line cap=round] (0.2, 2.4) -- (0.95, 3.15);
    \draw[line width=3.2pt, vecC, line cap=round] (0.2, 2.4) -- (0.95, 3.15);
    \node[right=1pt, font=\normalsize\bfseries, text=vecC!90!black] at (0.95, 3.15) {$c_r$};
  \end{scope}

\end{tikzpicture}


