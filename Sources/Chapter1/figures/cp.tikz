\providecommand{\Tn}[1]{\mathcal{#1}}
\providecommand{\Mx}[1]{\mathbf{#1}}

\begin{tikzpicture}

% 3-way Tensor \mathcal{X}
\begin{scope}[shift={(0,0)}]
    % Front face
    \draw[fill=purple!20, draw=purple, thick] (0,0) rectangle (1.5, 2.5);
    % Top face
    \draw[fill=purple!20, draw=purple, thick] (0,2.5) -- (0.8, 3.3) -- (2.3, 3.3) -- (1.5, 2.5) -- cycle;
    % Side face
    \draw[fill=purple!20, draw=purple, thick] (1.5,0) -- (2.3, 0.8) -- (2.3, 3.3) -- (1.5, 2.5) -- cycle;
    % Tensor label
    \node at (0.75, 1.25) {\Huge $\Tn{X}$};
\end{scope}

% Approximation symbol
\node at (3.2, 1.5) {\Huge $\approx$};

% Macro for the rank-1 outer product components
\newcommand{\drawcomponent}[2]{
  \begin{scope}[shift={(#1,0)}]
    
    % \mathbf{a} vector (vertical, red)
    \draw[line width=8pt, red, opacity=0.3] (0,0.2) -- (0,2.4);
    \draw[line width=4pt, red] (0,0.2) -- (0,2.4);
    \node[right] at (0.1, 0.3) {\Large $\mathbf{a}_{#2}$};

    % \mathbf{b} vector (horizontal, blue)
    \draw[line width=8pt, cyan!80!blue, opacity=0.3] (0.2, 2.5) -- (1.8, 2.5);
    \draw[line width=4pt, cyan!80!blue] (0.2, 2.5) -- (1.8, 2.5);
    \node[right] at (1.8, 2.5) {\Large $\mathbf{b}_{#2}$};

    % \mathbf{c} vector (diagonal, green)
    \draw[line width=8pt, green!60!black, opacity=0.3] (0.3, 2.8) -- (1.0, 3.5);
    \draw[line width=4pt, green!60!black] (0.3, 2.8) -- (1.0, 3.5);
    \node[right] at (1.0, 3.5) {\Large $\mathbf{c}_{#2}$};
    
  \end{scope}
}

% Draw the components and addition operators
\drawcomponent{4.5}{1}

\node at (7.3, 1.5) {\Huge $+$};

\drawcomponent{8.5}{2}

\node at (11.5, 1.5) {\Huge $+ \cdots +$};

\drawcomponent{13.5}{r}

\end{tikzpicture}
