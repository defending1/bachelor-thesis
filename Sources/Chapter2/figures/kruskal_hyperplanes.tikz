\begin{tikzpicture}[scale=1.15]
  % ================= SPAZIO C =================
  \begin{scope}[xshift=0cm]
    \node at (0, 3.2) {\large \textbf{Spazio $C$}};
    
    % Piano H_T
    \filldraw[fill=cBlue!15, draw=cBlue, thick, rounded corners=2pt] (-2.2, -1.0) -- (1.8, -1.0) -- (2.6, 1.0) -- (-1.4, 1.0) -- cycle;
    \node[cBlue!80!black, font=\large] at (1.4, -0.6) {$\hat{H}_T$};
    
    % Vettore w_{s_0} SUL piano
    \draw[->, thick, cBlue!80!black] (0,0) -- (0.6, 0.12) node[right, align=left, font=\small] {$w_{s_0}$ \\ ($s_0 \notin T$)};
    
    % Altro vettore sul piano
    \draw[->, thick, cGrey!80!black] (0,0) -- (-0.8, -0.4) node[below, font=\small] {$w_j \ (j \notin T)$};
    
    % Vettore w_{t_0} FUORI dal piano
    \draw[->, ultra thick, cRed] (0,0) -- (0.2, 2.2) node[above, font=\small] {$w_{t_0} \ (t_0 \in T)$};
    
    % Altro vettore fuori dal piano (in T)
    \draw[->, thick, cOrange] (0,0) -- (-1.5, 1.5) node[left, font=\small] {$w_t \ (t \in T)$};
  \end{scope}

  % ================= SPAZIO B =================
  \begin{scope}[xshift=5.8cm]
    \node at (0, 3.2) {\large \textbf{Spazio $B$}};
    
    % Piano H_S
    \filldraw[fill=cGreen!15, draw=cGreen, thick, rounded corners=2pt] (-2.2, -1.0) -- (1.8, -1.0) -- (2.6, 1.0) -- (-1.4, 1.0) -- cycle;
    \node[cGreen!80!black, font=\large] at (1.4, -0.6) {$\hat{H}_S$};
    
    % Vettori v_t SUL piano (in T)
    \draw[->, thick, cOrange] (0,0) -- (0.6, 0.12) node[right, align=left, font=\small] {$v_{t_0}$ \\ ($t_0 \in T$)};
    \draw[->, thick, cOrange] (0,0) -- (-0.6, -0.18) node[below left, font=\small] {$v_t \ (t \in T)$};
    
    % Vettore v_{s_0} FUORI dal piano
    \draw[->, ultra thick, cRed] (0,0) -- (0.2, 2.2) node[above, font=\small] {$v_{s_0} \ (s_0 \in S)$};
    
    % Altro vettore fuori dal piano (in S)
    \draw[->, thick, cGrey!80!black] (0,0) -- (-1.5, 1.5) node[left, font=\small] {$v_s \ (s \in S)$};
  \end{scope}
\end{tikzpicture}
