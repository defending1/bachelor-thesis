\definecolor{sourceColor}{HTML}{1E88E5}
\definecolor{sourceBg}{HTML}{E3F2FD}
\definecolor{antennaColor}{HTML}{E65100}
\definecolor{antennaBg}{HTML}{FFF3E0}
\definecolor{edgeBlue}{HTML}{1565C0}
\definecolor{edgeGreen}{HTML}{2E7D32}
\definecolor{edgePurple}{HTML}{6A1B9A}

\begin{tikzpicture}[
  >=Stealth,
  thick,
  stickman/.pic={
    % Head
    \draw[fill=., draw=., line width=1.2pt] (0, 0.45) circle [radius=0.15];
    % Torso
    \draw[line width=1.2pt] (0, 0.3) -- (0, -0.05);
    % Arms
    \draw[line width=1.2pt] (-0.2, 0.18) -- (0.2, 0.18);
    % Legs
    \draw[line width=1.2pt] (0, -0.05) -- (-0.16, -0.38);
    \draw[line width=1.2pt] (0, -0.05) -- (0.16, -0.38);
  },
  stickwoman/.pic={
    % Head
    \draw[fill=., draw=., line width=1.2pt] (0, 0.45) circle [radius=0.15];
    % Torso / Dress
    \draw[fill=., draw=., line width=1.2pt] (0, 0.3) -- (-0.2, -0.05) -- (0.2, -0.05) -- cycle;
    % Arms
    \draw[line width=1.2pt] (-0.2, 0.18) -- (0.2, 0.18);
    % Legs
    \draw[line width=1.2pt] (-0.08, -0.05) -- (-0.12, -0.38);
    \draw[line width=1.2pt] (0.08, -0.05) -- (0.12, -0.38);
  },
  antenna/.pic={
    % Base tower structure (triangular mast)
    \draw[fill=antennaBg, draw=antennaColor, line width=1.2pt] (-0.2, -0.5) -- (0, 0.5) -- (0.2, -0.5) -- cycle;
    % Crossbars
    \draw[draw=antennaColor, line width=0.9pt] (-0.14, -0.2) -- (0.14, -0.2);
    \draw[draw=antennaColor, line width=0.9pt] (-0.08, 0.15) -- (0.08, 0.15);
    % Top antenna mast tip
    \draw[draw=antennaColor, line width=1.4pt] (0, 0.5) -- (0, 0.8);
    \fill[antennaColor] (0, 0.8) circle [radius=0.05];
    % Signal arcs at top
    \draw[draw=antennaColor!80, line width=1.0pt] (0.08, 0.72) arc (-30:30:0.16);
    \draw[draw=antennaColor!80, line width=1.0pt] (0.14, 0.66) arc (-30:30:0.28);
    \draw[draw=antennaColor!80, line width=1.0pt] (-0.08, 0.72) arc (210:150:0.16);
    \draw[draw=antennaColor!80, line width=1.0pt] (-0.14, 0.66) arc (210:150:0.28);
  },
  signalLine1/.style={->, draw=edgeBlue!80, line width=1.1pt},
  signalLine2/.style={->, draw=edgeGreen!80, line width=1.1pt},
  signalLine3/.style={->, draw=edgePurple!80, line width=1.1pt}
]

  % --- USER POSITIONS (stickmen in 2D plane) ---
  \coordinate (u1) at (-3.8, 1.8);
  \coordinate (u2) at (-3.2, -1.8);
  \coordinate (u3) at (3.6, 0.2);

  \pic[edgeBlue!80] at (u1) {stickman};
  \pic[edgeGreen!80] at (u2) {stickman};
  \pic[edgePurple!80] at (u3) {stickwoman};

  % --- ANTENNA POSITIONS (antennae in 2D plane) ---
  \coordinate (a1) at (-0.5, 1.2);
  \coordinate (a2) at (0.5, -1.2);

  \pic at (a1) {antenna};
  \pic at (a2) {antenna};

  % --- SIGNAL TRANSMISSION EDGES ---
  % From User 1 (u1)
  \draw[signalLine1] ($(u1)+(0.25, 0.1)$) -- ($(a1)+(-0.35, 0.2)$);
  \draw[signalLine1] ($(u1)+(0.25, -0.1)$) -- ($(a2)+(-0.35, 0.3)$);

  % From User 2 (u2)
  \draw[signalLine2] ($(u2)+(0.25, 0.2)$) -- ($(a1)+(-0.35, -0.3)$);
  \draw[signalLine2] ($(u2)+(0.25, 0.0)$) -- ($(a2)+(-0.35, -0.2)$);

  % From User 3 (u3, to the right of antennae)
  \draw[signalLine3] ($(u3)+(-0.25, 0.2)$) -- ($(a1)+(0.35, 0.1)$);
  \draw[signalLine3] ($(u3)+(-0.25, -0.1)$) -- ($(a2)+(0.35, 0.1)$);

\end{tikzpicture}
