  abstract      = {We prove a lower bound of 2mn+2n-m-2 for the bilinear complexity of the multiplication of n\texttimes{}m-matrices with m\texttimes{}n-matrices using the substitution method (m\geqslant{}n\geqslant{}3). In particular, we obtain the improved lower bound of 19 for the bilinear complexity of 3\texttimes{}3-matrix multiplication.}
