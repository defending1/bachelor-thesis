@inproceedings{blaser2001,
  author        = {Bl\"{a}ser, Markus},
  title         = {A (5/2)n2-Lower Bound for the Multiplicative Complexity of n\texttimes{}n-Matrix Multiplication},
  year          = {2001},
  isbn          = {3540416951},
  publisher     = {Springer-Verlag},
  address       = {Berlin, Heidelberg},
  abstract      = {We prove a lower bound of 5/2n2 - 3n for the multiplicative complexity of n \texttimes{} n-matrix multiplication over arbitrary fields. More general, we show that for any finite dimensional semisimple algebra A with unity, the multiplicative complexity of the multiplication in A is bounded from below by 5/2 dim A - 3(n1 + ... + nt) if the decomposition of A \cong{} A1 \texttimes{} ... \texttimes{} At into simple algebras A\ensuremath{\Tau} \cong{} D\ensuremath{\Tau}n\ensuremath{\Tau}\texttimes{}n\ensuremath{\Tau} contains only noncommutative factors, that is, the division algebra D\ensuremath{\Tau} is noncommutative or n\ensuremath{\Tau} \geq{} 2.},
  booktitle     = {Proceedings of the 18th Annual Symposium on Theoretical Aspects of Computer Science},
  pages         = {99–109},
